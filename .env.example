# Copy this file to .env and fill it in.  (.env is git-ignored.)

# ---- Where to look ----------------------------------------------------------
ZIP_CODE=12345
# Your two stores. Run `python3 stock_checker.py --list-stores` to find these.
# Leave blank to automatically use the MAX_STORES nearest stores to ZIP_CODE.
STORE_NUMBERS=
MAX_STORES=2

# ---- What to look for -------------------------------------------------------
# Both colors (Night Sky, Star White) are checked automatically.
CAPACITIES=256gb,512gb
# Optional: skip auto-discovery. These are the US unlocked iPhone Duo parts:
# PART_NUMBERS=MK1E4LL/A,MK1F4LL/A,MK1G4LL/A,MK1H4LL/A

# Text again about the same phone/store if it's still in stock after this many minutes.
REALERT_MINUTES=60

# ---- Text message: set up at least ONE --------------------------------------

# Option A: Twilio (real SMS, about 1 cent per text)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+15551234567
# SMS_TO=+15557654321

# Option B: free email-to-text through your carrier, sent from Gmail
#   Verizon: 5557654321@vtext.com    T-Mobile: 5557654321@tmomail.net
#   (AT&T shut down its email-to-text gateway in 2025, so use A or C instead.)
#   SMTP_PASSWORD must be a Gmail "App password", not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMS_GATEWAY_EMAIL=5557654321@vtext.com

# Option C: free push notification in the ntfy app (iOS/Android), not SMS
# NTFY_TOPIC=pick-a-long-random-name-here
